{
  "name": "app",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "playwright test",
    "bundle:check": "node scripts/check-bundle-budget.cjs",
    "build:verify": "npm run build && npm run bundle:check",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.cjs",
    "i18n:validate": "node scripts/i18n/validate-locales.cjs",
    "i18n:scan": "node scripts/i18n/scan-ui-literals.cjs",
    "i18n:pseudo": "node scripts/i18n/generate-pseudo-locales.cjs",
    "i18n:check": "npm run i18n:validate && npm run i18n:scan",
    "android:jni:check": "node scripts/check-android-jni-contract.cjs",
    "android:version:check": "node scripts/verify-android-release-version.cjs",
    "release:version:check": "node ../scripts/release-tag-policy.cjs --app-root .",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "framer-motion": "^12.26.2",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.1",
    "lucide-react": "^0.562.0",
    "mp4box": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
