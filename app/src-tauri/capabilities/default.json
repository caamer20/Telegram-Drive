{
  "identifier": "default",
  "description": "Standard permissions for Telegram Drive",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "shell:allow-open",
    "store:default",
    "updater:default",
    "process:allow-restart",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:scope-home-recursive",
    "fs:scope-download-recursive"
  ]
}
